# Use the LXC's own IPv4 address, not the Proxmox management address.
LAB_BIND_IP=192.168.178.50
# Exact URL in the browser, without a trailing slash.
# For public HTTPS, use https://lab.your-domain.example instead.
LAB_ORIGIN=http://192.168.178.50

# Add these yourself in .env.
# GATEWAY_TOKEN=<output of openssl rand -hex 32>
# ANYONE_TERMS_FLAG=--agree-to-terms

# Optional override with a reviewed image digest or published commit tag.
# ANYONE_IMAGE=ghcr.io/anyone-protocol/anyone-rust:3d447468a4ec0c536a221024ecc9fe30f18d94cf

+pub struct VerifiedRelays {
+    addresses: HashSet<SocketAddr>,
+    valid_until: Option<std::time::SystemTime>,
+}
+
+impl VerifiedRelays {
+    pub fn new(addresses: HashSet<SocketAddr>, valid_until: std::time::SystemTime) -> Self {
+        Self { addresses, valid_until: Some(valid_until) }
+    }
+
+    pub fn current(&self, now: std::time::SystemTime) -> Option<&HashSet<SocketAddr>> {
+        self.valid_until.filter(|until| now < *until).map(|_| &self.addresses)
+    }

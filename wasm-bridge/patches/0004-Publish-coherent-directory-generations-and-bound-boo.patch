+/// Keep the immutable pair together behind an atomically replaced manifest.
 fn write_bootstrap_archive(dir: &Path, consensus: &[u8], certs: &[u8], microdescs: &[u8]) -> Result<()> {
     use zip::write::SimpleFileOptions;
     use zip::CompressionMethod;
 
+    let mut hash = Sha256::new();
+    hash.update(b"privacy-lab bootstrap v1\0");
+    for part in [consensus, certs, microdescs] {
+        hash.update((part.len() as u64).to_le_bytes());
+        hash.update(part);
+    }
+    let id = hex::encode(hash.finalize());
+    let generations = dir.join("generations");
+    let generation = generations.join(&id);
+    let ready = generation.join("consensus-microdesc.txt").is_file()
+        && generation.join("bootstrap.zip.zst").is_file();
+    let old: Option<PublishedGenerations> = std::fs::read(dir.join("current.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice(&bytes).ok());
+    if ready && old.as_ref().is_some_and(|manifest| manifest.current == id)
+        && ["bootstrap.zip", "bootstrap.zip.zst", "bootstrap.etag"]
+            .iter()
+            .all(|name| dir.join(name).is_file())
+    {
+        return Ok(());
+    }

     let etag = hex::encode(sha3::Sha3_256::digest(&zip_buf));
     atomic_write(dir, "bootstrap.etag", etag.as_bytes())?;
-
     atomic_write(dir, "bootstrap.zip", &zip_buf)?;
     atomic_write(dir, "bootstrap.zip.zst", &zst_buf)?;
+    if !ready {

+        let previous = if manifest.current == id {
+            manifest.previous.as_ref()?
+        } else {
+            &manifest.current
+        };
+        is_generation_id(previous).then(|| previous.clone())
+    });
+    let manifest = PublishedGenerations { current: id, previous };
+    atomic_write(dir, "current.json", &serde_json::to_vec(&manifest)?)?;
+
+    // Keep the prior manifest's previous files for readers that opened it just
+    // before publication. They are reclaimed on a later successful rotation.
+    if let Err(error) = prune_generations(&generations, &manifest, old.as_ref()) {
+        tracing::warn!("could not prune bootstrap generations: {error:#}");
+    }
     tracing::info!(
-        "wrote bootstrap.zip ({} bytes), .zst ({} bytes)",
+        "published bootstrap {} ({} bytes), .zst ({} bytes)",
+        manifest.current,
         zip_buf.len(),
         zst_buf.len(),
     );
     Ok(())
 }
 
+fn prune_generations(
+    generations: &Path,
+    manifest: &PublishedGenerations,
+    old: Option<&PublishedGenerations>,
+) -> Result<()> {
+    let protected = [
+        Some(manifest.current.as_str()),
+        manifest.previous.as_deref(),
+        old.and_then(|item| item.previous.as_deref()),
+    ];
+    for entry in std::fs::read_dir(generations)? {
+        let entry = entry?;
+        let name = entry.file_name();
+        if let Some(id) = name.to_str()
+            && is_generation_id(id)
+            && !protected.contains(&Some(id))
+            && entry.file_type()?.is_dir()
+        {
+            std::fs::remove_dir_all(entry.path())?;
+        }
+    }
+    Ok(())
+}

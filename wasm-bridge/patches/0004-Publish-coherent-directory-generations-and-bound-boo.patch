+    fn publication_keeps_the_snapshot_and_consensus_in_one_generation() {
+        let dir = TempDir::new("sync-generation");
+        let path = dir.path();
+        write_bootstrap_archive(path, b"consensus", b"certs", b"partial").unwrap();
+        let first: PublishedGenerations =
+            serde_json::from_slice(&std::fs::read(path.join("current.json")).unwrap()).unwrap();
+        assert!(is_generation_id(&first.current));
+        assert!(first.previous.is_none());
+
+        write_bootstrap_archive(path, b"consensus", b"certs", b"complete").unwrap();
+        let second: PublishedGenerations =
+            serde_json::from_slice(&std::fs::read(path.join("current.json")).unwrap()).unwrap();
+        assert_ne!(first.current, second.current, "descriptor recovery rotates the snapshot");
+        assert_eq!(second.previous.as_deref(), Some(first.current.as_str()));
+
+        let generation = path.join("generations").join(&second.current);
+        let consensus = std::fs::read(generation.join("consensus-microdesc.txt")).unwrap();
+        let compressed = std::fs::read(generation.join("bootstrap.zip.zst")).unwrap();
+        let members = parse_like_the_client(&zstd::decode_all(compressed.as_slice()).unwrap());
+        assert_eq!(members[0].1, consensus);
+        assert_eq!(members[2].1, b"complete");
+        assert!(path.join("generations").join(&first.current).is_dir());
+
+        write_bootstrap_archive(path, b"consensus", b"certs", b"complete").unwrap();
+        let repeated: PublishedGenerations =
+            serde_json::from_slice(&std::fs::read(path.join("current.json")).unwrap()).unwrap();
+        assert_eq!(repeated.current, second.current);
+        assert_eq!(repeated.previous, second.previous);
+    }

 /// content-encoding on KPS streams). Raw zip bytes pass through unchanged.
 fn maybe_decompress_zstd(bytes: Vec<u8>) -> Result<Vec<u8>, String> {
-    if bytes.len() < 4 || bytes[..4] != ZSTD_MAGIC {

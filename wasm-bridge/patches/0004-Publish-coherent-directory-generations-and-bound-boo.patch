+
+fn decode_snapshot(bytes: Vec<u8>, output_limit: usize) -> Result<Vec<u8>, String> {
+    let size_error = || format!("fast bootstrap: snapshot exceeds {output_limit} decoded bytes");
+    if !bytes.starts_with(&ZSTD_MAGIC) {
+        return if bytes.len() <= output_limit {
+            Ok(bytes)
+        } else {
+            Err(size_error())
+        };
+    }
+    if bytes.len() > MAX_COMPRESSED_BOOTSTRAP_BYTES {
+        return Err("fast bootstrap: compressed snapshot exceeds the input limit".into());
     }
     let cursor = std::io::Cursor::new(bytes);
-    let mut decoder = ruzstd::decoding::StreamingDecoder::new(cursor)
-        .map_err(|e| format!("fast bootstrap: zstd decode error: {}", e))?;
+    let mut decoder =
+        ruzstd::decoding::StreamingDecoder::new_with_max_window_size(cursor, MAX_ZSTD_WINDOW_BYTES)
+            .map_err(|e| format!("fast bootstrap: zstd decode error: {e}"))?;
     let mut decompressed = Vec::new();
-    std::io::Read::read_to_end(&mut decoder, &mut decompressed)
-        .map_err(|e| format!("fast bootstrap: zstd decompress error: {}", e))?;
+    decoder
+        .by_ref()
+        .take(output_limit as u64)
+        .read_to_end(&mut decompressed)
+        .map_err(|e| format!("fast bootstrap: zstd decompress error: {e}"))?;
+    if decompressed.len() == output_limit
+        && decoder
+            .read(&mut [0_u8; 1])
+            .map_err(|e| format!("fast bootstrap: zstd decompress error: {e}"))? != 0
+    {
+        return Err(size_error());
+    }
